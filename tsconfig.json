{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "rootDir": ".",
    "outDir": "dist",

    "esModuleInterop": true,
    "resolveJsonModule": true,

    "strict": true,
    "skipLibCheck": true,

    "types": ["node"],

    "sourceMap": true
  },
  "include": [
    "electron/**/*.ts",
    "backend/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "renderer"
  ]
}
